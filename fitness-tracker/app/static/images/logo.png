<script type="application/json" data-nuxt-data="nuxt-app" data-ssr="true" id="__NUXT_DATA__">[["ShallowReactive",1],{"data":2,"state":1133,"once":1136,"_errors":1137,"serverRendered":9,"path":1140,"pinia":1141},["ShallowReactive",3],{"index":4},{"pageType":5,"isLoading":6,"context":7,"user":93,"page":94},"Maker",false,{"siteName":8,"isDesignCom":9,"isUserAuthenticated":6,"theme":10,"brandCrowdBranding":11,"brandCrowdEnvironment":12,"resource":13,"head":17,"isNotBrandCrowdOrigin":9,"brazeConfig":74,"raygunConfig":77,"googleTagManagerConfig":81,"smartlingVisualContextConfig":83,"mixpanelConfig":85,"cookie":90,"sessionId":89,"isMultiLingualEnabled":6,"requestCountry":92,"initialiseFoundationScript":9,"includeLogoTemplateProductMeta":9},"Design.com",true,"bc","Dcom","Prod",{"tailwindCssPath":14,"fontRefs":15},"/dist/css/tailwind-designCom.css?v=b-z_pqRg4DbYN7xgOqvOI20FiME2epcjKT7eUSzvayY",[16],"https://bcassetcdn.com/fonts/inter.woff2",{"title":18,"metas":19,"links":23,"scripts":44,"openGraphMeta":59,"productMeta":68},"Health Fitness Running Logo | Design.com Logo Maker | Design.com",[20],{"name":21,"content":22},"Description","The Runner Fitness Health Hub logo embodies the spirit of athleticism and dedication. Featuring a dynamic silhouette of a female runner in mid-stride, the design captures the essence of movement and motivation. With vibrant colors symbolizing energy and vitality, the logo reflects the hub's commitment to empowering athletes at all levels—from aspiring marathoners to seasoned triathletes. The incorporation of elements like a heartbeat line and stylized running shoes emphasizes a holistic approach to fitness and health, while tags like \"championship,\" \"competition,\" and \"coaching\" highlight the supportive community that fosters growth and achievement. Whether training for a decathlon or participating in a varsity league, the Runner Fitness Health Hub stands as a beacon for women in sport, inspiring them to push their limits and reach new heights in their athletic journeys.",[24,28,31,34,38,41],{"key":25,"rel":26,"href":27,"async":9},"app-bc-dcom-css","stylesheet","https://dcstatic.com/css/app-bc-dcom-CB323.css",{"key":29,"rel":26,"href":30,"async":9},"maker-css","/dist/css/library.app-maker-designCom.min.css?v=q1o0pjfJG5TxTfNwULYAh8YtCww-XW17i4X5o49ZS2U",{"rel":32,"href":33,"async":6},"canonical","https://www.design.com/maker/logo/health-fitness-running-1036014/details",{"rel":35,"href":36,"async":6,"sizes":37},"icon","https://bcassetcdn.com/favicon/dcom-production/favicon.ico","32x32",{"rel":35,"href":39,"async":6,"type":40},"https://bcassetcdn.com/favicon/dcom-production/icon.svg","image/svg+xml",{"rel":42,"href":43,"async":6},"apple-touch-icon","https://bcassetcdn.com/favicon/dcom-production/apple-touch-icon.png",[45,47,49,51,53,55,57],{"src":46},"https://polyfill-fastly.io/v3/polyfill.js?features=Array.prototype.find,Promise&rum=0",{"src":48},"/maker/assets/js/jquery-3.3.1.min.js?v=160a426ff2894252cd7cebbdd6d6b7da8fcd319c65b70468f10b6690c45d02ef",{"src":50},"/maker/assets/js/foundation.min.js?v=5942879cbac8af1f1d7b0fff22948498f37f353dc318012621e3d06081092cbb",{"src":52},"/maker/assets/js/tt-util.js?v=093ca1ee0d9d80515cc302144e771ad0fe4ba466f40e84a4879f0cb161f92201",{"src":54},"/maker/assets/js/bc.marketing.js?v=f59e01ee24bb3aeb11e2dcaa653e03e3bbea427af075edde4489b8b00906c8da",{"src":56},"/maker/assets/js/bc.load-fabric-image.js?v=beda7321531f63b44daad91845e78e3540ca3829f41e3133a36b0a61352551a8",{"src":58},"/maker/assets/js/designReferrerHelper.js?v=0f684dc714590adcf29c27365ee41b97afaa4c55c04eb3f327a0536535a0fab8",{"title":18,"siteName":8,"pageUrl":60,"type":61,"pageDescription":22,"facebookOpenGraphMetaAppId":62,"image":63,"priceAmount":64,"priceCurrency":65,"twitterUsername":66,"logoUrl":67},"https://www.design.com/maker/logo/health-fitness-running-1036014","product","61552557322271","https://dynamic.design.com/asset/logo/0ca4ae87-7903-40fc-8bd8-3f1a7aafcc33/insta-square?logoTemplateVersion=1&v=638