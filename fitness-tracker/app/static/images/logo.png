<script bodyopen="" data-hid="customer-ua-tracking">
    (function () {
        function altFind(arr, callback) {
            for (var i = 0; i < arr.length; i++) {
                var match = callback(arr[i]);
                if (match) {
                    return arr[i];
                    break;
                }
            }
        }
        
        function getCookie(name) {
            var retVal = null;
        
            if (document && document.cookie) {
                var cookies = document.cookie.split(';');
        
                retVal = altFind(cookies, function (val) {
                    return val.trim().indexOf(name + '=') === 0;
                });
        
                if (retVal) {
                    retVal = retVal && retVal.replace(name + '=', '').trim();
                }
            }
        
            return retVal;
        }
        
        function removeCookie(name) {
            document.cookie = name + '=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
        }
        
        var leadReferrerCookieKey = 'brandcrowd-user-lead-referrer';
        var leadReferrer = getCookie(leadReferrerCookieKey);
        if (leadReferrer) {
            removeCookie(leadReferrerCookieKey);
        }
        
        window.dataLayer = window.dataLayer || [];
        
        
             
        window.dataLayer.push({"user_id":null,"user_type":"Guest"});
    })();</script>
<script bodyopen="" data-hid="google-tag-manager">
      window.dataLayer = window.dataLayer || [];  
        
      window.dataLayer.push({
          version: {
              branding: 'Dcom',
              environment: 'live',
          },
      });</script>
